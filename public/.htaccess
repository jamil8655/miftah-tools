# ----------------------------------------------------------------------
# Miftah Tools - Hostinger Apache / LiteSpeed Web Configuration
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Redirect legacy / alternate sitemap requests to authoritative primary sitemap.xml
  RewriteRule ^(page-sitemap|post-sitemap|sitemap-index|sitemap_index|sitemap1)\.xml$ /sitemap.xml [R=301,L]

  # 3. Prevent directory listings
  Options -Indexes

  # 4. Serve existing files directly (sitemap.xml, robots.txt, static assets)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 5. Handle HTML export paths (Next.js trailingSlash: true)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 6. Fallback 404 to /404.html
  ErrorDocument 404 /404.html
</IfModule>

# ----------------------------------------------------------------------
# Proper MIME types for WebAssembly, XML, Service Workers, JSON, and Fonts
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt
  AddType application/wasm .wasm
  AddType application/manifest+json .webmanifest .json
  AddType application/javascript .js .mjs
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

# ----------------------------------------------------------------------
# Compression (Gzip / Deflate / Brotli)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json application/xml application/wasm
  AddOutputFilterByType DEFLATE font/ttf font/otf font/eot font/woff font/woff2 image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# Leverage Browser Caching for Ultimate Speed (1 Year for Static Assets)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML & Manifest (Fresh updates)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 1 week"

  # Static Assets with hashes in _next/
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/wasm "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# ----------------------------------------------------------------------
# Security & Special File Headers
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  <Files "sitemap.xml">
    Header set Content-Type "application/xml; charset=utf-8"
    Header set Cache-Control "max-age=3600, public"
  </Files>

  <Files "robots.txt">
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Cache-Control "max-age=3600, public"
  </Files>
</IfModule>
