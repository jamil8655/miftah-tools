<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="miftah_downloads" path="Download" />
    <external-files-path name="miftah_ext_files" path="." />
    <external-cache-path name="miftah_ext_cache" path="." />
    <files-path name="miftah_internal_files" path="." />
    <cache-path name="miftah_cache" path="." />
</paths>
