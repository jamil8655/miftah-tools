rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.super_admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'jrahmanansari132@gmail.com' ||
        request.auth.token.email == 'jamil8655@gmail.com' ||
        request.auth.token.email == 'hafizjamilurrahman@gmail.com' ||
        request.auth.token.email == 'jamilurrahman@gmail.com'
      );
    }

    // Maximum file upload size: 100 MB
    function isAllowedFileSize() {
      return request.resource.size < 100 * 1024 * 1024;
    }

    // User Private Storage (Profile photos, PDFs, Images)
    match /users/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isAllowedFileSize();
    }

    // User-Isolated Temporary Processing Files
    match /temp/{userId}/{jobId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isAllowedFileSize();
    }

    // Public Assets / Tool Templates: Anyone can read, only Admin can write
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isAllowedFileSize();
    }

    // Admin System Backups & Audit Exports
    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
